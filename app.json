{
  "expo": {
    "name": "Turtle-App",
    "slug": "Turtle-App",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "turtleapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rocklinb.TurtleApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.rocklinb.TurtleApp",
      "predictiveBackGestureEnabled": false,

      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "minSdkVersion": 24,

      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],

      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "turtleapp" },
            { "scheme": "exp+turtle-app" }
          ]
        }
      ]
    },

    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow Turtle App to connect to bluetooth devices",
          "neverForLocation": true
        }
      ],
      // Optional: force SDK versions via build properties (recommended)
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "b63e09e0-b109-480e-811a-b41568e581c0"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b63e09e0-b109-480e-811a-b41568e581c0"
    }
  }
}